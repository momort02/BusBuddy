rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isGroupMember(groupId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }
    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        isGroupMember(request.resource.data.groupId) &&
        get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerId == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }
    match /groups/{groupId} {
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.auth.uid in request.resource.data.memberIds;
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow update: if signedIn() && (
        request.auth.uid == resource.data.ownerId ||
        (request.auth.uid in request.resource.data.memberIds &&
         request.resource.data.memberIds.hasAll(resource.data.memberIds) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
         exists(/databases/$(database)/documents/invites/$(resource.data.inviteCode)) &&
         get(/databases/$(database)/documents/invites/$(resource.data.inviteCode)).data.groupId == groupId)
      );
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;
    }
    match /trips/{tripId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if signedIn() && isGroupMember(request.resource.data.groupId) &&
        request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() && isGroupMember(resource.data.groupId) &&
        request.auth.uid == resource.data.createdBy;
    }
    match /responses/{responseId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create, update: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        isGroupMember(request.resource.data.groupId) &&
        request.resource.data.status in ['yes','no','unsure'] &&
        exists(/databases/$(database)/documents/trips/$(request.resource.data.tripId)) &&
        get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.groupId == request.resource.data.groupId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}